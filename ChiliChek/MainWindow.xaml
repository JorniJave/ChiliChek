<Window x:Class="ChiliChek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChiliChek.UI"
        Title="Chili Chek - Rust Cheat Checker" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ThreatConverter x:Key="ThreatConverter"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF6666"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="#FF4A4A" Height="40">
            <Image Source="/Resources/chili_logo.png" Width="30" Margin="10,0,0,0" ImageFailed="Image_ImageFailed"/>
            <TextBlock Text="Chili Chek" Style="{StaticResource HeaderStyle}" FontSize="18"/>
            <TextBlock Text="Версия 1.0.0" Style="{StaticResource HeaderStyle}" FontSize="12"/>
            <TextBlock Text="{Binding UserName, StringFormat='Пользователь: {0}'}" Style="{StaticResource HeaderStyle}" FontSize="12"/>
            <Button Content="Сканировать" Command="{Binding ScanCommand}"/>
            <Button Content="Остановить" Command="{Binding StopCommand}"/>
            <Button Content="Экспорт логов" Command="{Binding ExportCommand}"/>
            <Button Content="Очистить логи" Command="{Binding ClearLogsCommand}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Угрозы">
                <ListView ItemsSource="{Binding Threats}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="100"/>
                            <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="200"/>
                            <GridViewColumn Header="Детали" DisplayMemberBinding="{Binding Details}" Width="300"/>
                            <GridViewColumn Header="Время" DisplayMemberBinding="{Binding Timestamp}" Width="150"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                    <Setter Property="Background" Value="LightCoral"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TabItem>
            <TabItem Header="Steam">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding SteamInfo.SteamId, StringFormat='SteamID: {0}'}" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding SteamInfo.Name, StringFormat='Имя: {0}'}" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding SteamInfo.ProfileStatus, StringFormat='Статус профиля: {0}'}" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding SteamInfo.VacBans, StringFormat='VAC-баны: {0}'}" FontSize="14" Margin="5"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Настройки">
                <StackPanel Margin="10">
                    <TextBlock Text="Чувствительность сканирования" FontSize="12" Margin="5"/>
                    <ComboBox SelectedIndex="{Binding SensitivityLevel}" Width="200" Margin="5">
                        <ComboBoxItem Content="Низкая"/>
                        <ComboBoxItem Content="Средняя"/>
                        <ComboBoxItem Content="Высокая"/>
                    </ComboBox>
                    <TextBlock Text="Исключённые папки/процессы" FontSize="12" Margin="5"/>
                    <TextBox Text="{Binding ExcludedPaths}" Width="200" Margin="5"/>
                    <CheckBox Content="Включить JournalTrace" IsChecked="{Binding UseJournalTrace}" Margin="5"/>
                    <CheckBox Content="Включить Everything" IsChecked="{Binding UseEverything}" Margin="5"/>
                    <CheckBox Content="Включить ShellBag Analyzer" IsChecked="{Binding UseShellBag}" Margin="5"/>
                    <CheckBox Content="Включить RegScanner" IsChecked="{Binding UseRegScanner}" Margin="5"/>
                    <CheckBox Content="Включить USBDeview" IsChecked="{Binding UseUsbDeview}" Margin="5"/>
                    <TextBlock Text="Режим сканирования" FontSize="12" Margin="5"/>
                    <ComboBox SelectedIndex="{Binding ScanMode}" Width="200" Margin="5">
                        <ComboBoxItem Content="Однократное"/>
                        <ComboBoxItem Content="Периодическое (каждые 5 минут)"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Логи">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="5">
                        <CheckBox Content="Процессы" IsChecked="{Binding FilterProcesses}" Margin="5"/>
                        <CheckBox Content="Файлы" IsChecked="{Binding FilterFiles}" Margin="5"/>
                        <CheckBox Content="Макросы" IsChecked="{Binding FilterMacros}" Margin="5"/>
                        <CheckBox Content="Реестр" IsChecked="{Binding FilterRegistry}" Margin="5"/>
                        <CheckBox Content="USB" IsChecked="{Binding FilterUsb}" Margin="5"/>
                        <CheckBox Content="Сеть" IsChecked="{Binding FilterNetwork}" Margin="5"/>
                        <CheckBox Content="Steam" IsChecked="{Binding FilterSteam}" Margin="5"/>
                        <TextBox Text="{Binding LogSearchQuery}" Width="150" Margin="5" ToolTip="Поиск по ключевым словам"/>
                    </StackPanel>
                    <TextBox x:Name="OutputTextBox" Grid.Column="1" Margin="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                             Text="{Binding FilteredThreats, Converter={StaticResource ThreatConverter}}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FF4A4A" Height="30">
            <TextBlock Text="{Binding NotificationText}" Style="{StaticResource HeaderStyle}"/>
            <ProgressBar Value="{Binding ScanProgress}" Width="200" Height="20" Margin="10,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Image Source="/Resources/vk.png" Width="20" Margin="5,0" ImageFailed="Image_ImageFailed"/>
                <Image Source="/Resources/telegram.png" Width="20" Margin="5,0" ImageFailed="Image_ImageFailed"/>
                <Image Source="/Resources/youtube.png" Width="20" Margin="5,0" ImageFailed="Image_ImageFailed"/>
                <Image Source="/Resources/chrome.png" Width="20" Margin="5,0" ImageFailed="Image_ImageFailed"/>
                <Button Content="Что нового" Click="WhatsNewButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>